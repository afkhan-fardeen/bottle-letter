# Leave Supabase values empty to run in local demo mode (messages stay in this browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The name shown to her in "What you leave here can be read by [Name]."
VITE_HIS_NAME=Him
# His login email (the account created in Supabase Auth). Defaults to the one in schema.sql.
VITE_HIS_EMAIL=
